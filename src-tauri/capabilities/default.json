{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, the stats folder picker, run notifications, and benchmark threshold sync.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://evxl.app/*" }, { "url": "https://kovaaks.com/*" }]
    }
  ]
}
